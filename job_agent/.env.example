# ==========================================
# AI Model Configuration
# ==========================================
# ChatBrowserUse is the recommended default model (highest accuracy + fastest speed for web tasks)
BROWSER_USE_API_KEY=
# OpenAI or OpenAI-Compatible APIs (e.g. Azure OpenAI, OpenRouter, vLLM, Ollama, Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna

# Other Providers
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ==========================================
# Candidate Profile (Optional)
# ==========================================
# RECOMMENDED: Run 'uv run job-agent setup' to interactively configure your profile
# and auto-parse your resume into data/user_profile.json!
# The values below only serve as optional overrides or fallbacks.
USER_NAME=""
USER_EMAIL="alex.johnson@example.com"
USER_PHONE="+1 (555) 234-5678"
USER_LOCATION="Remote / San Francisco, CA"
USER_LINKEDIN="https://www.linkedin.com/in/alex-johnson-dev"
USER_GITHUB="https://github.com/alex-johnson"
USER_PORTFOLIO="https://alexjohnson.dev"
USER_EXPERIENCE_YEARS=4
USER_CURRENT_ROLE="Senior Backend Engineer"
USER_SKILLS="Python, FastAPI, TypeScript, React, Docker, Kubernetes, PostgreSQL, AWS, System Design, AI Agents"
USER_SUMMARY="Senior backend engineer specializing in high-throughput distributed systems and AI workflows."

# Path to resume files
USER_RESUME_PATH="job_agent/data/resume.pdf"
USER_RESUME_TEXT_PATH="job_agent/data/resume.txt"

# ==========================================
# Job Board Login Credentials (Optional)
# If using Chrome user_data_dir, credentials in browser are re-used automatically!
# If provided here, credentials are kept secure and never passed to the LLM.
# ==========================================
LINKEDIN_EMAIL=""
LINKEDIN_PASSWORD=""
NAUKRI_EMAIL=""
NAUKRI_PASSWORD=""
WELLFOUND_EMAIL=""
WELLFOUND_PASSWORD=""

# ==========================================
# Chrome Session & Profile
# Re-uses your real logged-in Chrome profile to bypass 2FA / bot detection
# ==========================================
CHROME_USER_DATA_DIR="~/.config/browseruse/profiles/job_agent"

# ==========================================
# Cold Outreach SMTP Configuration (Optional)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
